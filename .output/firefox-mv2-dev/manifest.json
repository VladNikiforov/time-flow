{
  "manifest_version": 2,
  "name": "TimeFlow - Time Tracker",
  "description": "Focus on what matters by keeping track of your time on the web",
  "version": "0.0.0",
  "icons": {
    "16": "favicon/16.png",
    "48": "favicon/48.png",
    "128": "favicon/128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "http://localhost/*"
  ],
  "commands": {
    "wxt:reload-extension": {
      "description": "Reload the extension during development",
      "suggested_key": {
        "default": "Alt+R"
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": "script-src 'self' http://localhost:3000; object-src 'self';"
}